{
  "name": "shrimp",
  "version": "0.2.6",
  "description": "Self-Hosted RAG Intelligence Model Project",
  "author": {
    "name": "TheSingularis",
    "email": "jordan.sluiter@icloud.com"
  },
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "web": "bash start.sh",
    "electron": "bash start-electron.sh",
    "build": "bash build.sh",
    "build:linux": "bash build.sh --linux",
    "build:mac": "bash build.sh --mac",
    "build:win": "bash build.sh --win"
  },
  "build": {
    "appId": "com.shrimp.app",
    "productName": "SHRIMP",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist-electron",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "frontend/public/icons/**/*",
      "backend/**/*",
      "!backend/.venv/**/*",
      "!backend/__pycache__/**/*",
      "!backend/**/__pycache__/**/*",
      "!**/node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!.venv/**/*",
          "!__pycache__/**/*",
          "!**/__pycache__/**/*"
        ]
      },
      {
        "from": "backend/.venv",
        "to": "backend/.venv",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "pacman"
      ],
      "icon": "frontend/public/icons/shrimp(1).png",
      "category": "Utility"
    },
    "mac": {
      "target": "dmg",
      "icon": "frontend/public/icons/shrimp(1).png"
    },
    "win": {
      "target": "nsis",
      "icon": "frontend/public/icons/shrimp(1).png"
    }
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0"
  }
}
